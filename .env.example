# Fournisseur LLM vision : gemini | openai | anthropic | ollama
LLM_PROVIDER=gemini
# Facultatif : remplace le modèle par défaut du fournisseur (ex. gemini-3.5-flash)
LLM_MODEL=

# Renseigner uniquement la clé du fournisseur choisi
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Ollama (local)
OLLAMA_HOST=http://localhost:11434
